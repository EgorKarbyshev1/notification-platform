@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Вариант B — события и независимые обработчики каналов
Person(client, "Клиент", "Настройки, история и подтверждения")
Person(operator, "Сотрудник", "Кампании и поддержка")
System_Ext(bank, "Продуктовые системы банка", "Собственный outbox")
System_Ext(push, "Push-провайдер", "Внешняя доставка")
System_Ext(sms, "SMS-провайдер", "Внешняя доставка")
System_Ext(email, "Email-провайдер", "Внешняя доставка")
System_Boundary(platform, "Платформа уведомлений") {
  Container(api, "API и генератор кампаний", "Go", "Приём, история, настройки, обратные вызовы")
  ContainerDb(db, "Состояние платформы", "PostgreSQL, 3 узла", "Планы, попытки, настройки, таймеры, outbox, входящие ID")
  Container(pub, "Издатель outbox", "Go", "Публикует события, команды и результаты")
  ContainerQueue(kafka, "Событийный журнал", "Kafka, минимум 3 узла", "Отдельные темы по типам и каналам, ключ ID уведомления")
  Container(coord, "Координатор доставки", "Go", "Переходы состояния, таймеры, команды каналов")
  Container(pushWorker, "Обработчик Push", "Go", "Исполняет только команды Push")
  Container(smsWorker, "Обработчик SMS", "Go", "Исполняет только команды SMS")
  Container(emailWorker, "Обработчик Email", "Go", "Исполняет только команды Email")
  Container(monitor, "Наблюдение", "Prometheus / Alertmanager", "Метрики, отставания, тревоги")
}
Rel(bank, api, "Передаёт события с ключом", "HTTPS")
Rel(client, api, "Настройки, история, подтверждение Push", "HTTPS")
Rel(operator, api, "Кампании и история", "HTTPS")
Rel(api, db, "Состояние, входящие события и outbox", "SQL / TLS")
Rel(pub, db, "Читает outbox, отмечает публикацию", "SQL / TLS")
Rel(pub, kafka, "Публикует с подтверждением", "Kafka / TLS")
Rel(kafka, coord, "Уведомления и результаты", "Kafka / TLS")
Rel(coord, db, "Планы, дедупликация, таймеры, outbox команд", "SQL / TLS")
Rel(kafka, pushWorker, "Команды Push", "Kafka / TLS")
Rel(kafka, smsWorker, "Команды SMS", "Kafka / TLS")
Rel(kafka, emailWorker, "Команды Email", "Kafka / TLS")
Rel(pushWorker, db, "Политики, аренды, попытки, outbox результатов", "SQL / TLS")
Rel(smsWorker, db, "Политики, аренды, попытки, outbox результатов", "SQL / TLS")
Rel(emailWorker, db, "Политики, аренды, попытки, outbox результатов", "SQL / TLS")
Rel(pushWorker, push, "Отправляет и сверяет статус", "HTTPS")
Rel(smsWorker, sms, "Отправляет и сверяет статус", "HTTPS")
Rel(emailWorker, email, "Отправляет и сверяет статус", "HTTPS")
Rel(push, api, "Обратные вызовы", "HTTPS")
Rel(sms, api, "Обратные вызовы", "HTTPS")
Rel(email, api, "Обратные вызовы", "HTTPS")
Rel(monitor, api, "Метрики", "HTTPS")
Rel(monitor, coord, "Метрики", "HTTPS")
Rel(monitor, pub, "Метрики", "HTTPS")
Rel(monitor, pushWorker, "Метрики", "HTTPS")
Rel(monitor, smsWorker, "Метрики", "HTTPS")
Rel(monitor, emailWorker, "Метрики", "HTTPS")
Rel(monitor, kafka, "Метрики отставания", "HTTPS")
@enduml
